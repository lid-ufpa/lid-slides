%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% TITLE PAGE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\setbeamertemplate{title page}{
    \begin{tikzpicture}[remember picture, overlay]
        \node[anchor=north west, xshift=5pt, yshift=-30pt] at (current page.north west)
        {\includegraphics[width=2cm]{./assets/logo-ufpa.pdf}};
        \node[anchor=north east, xshift=-10pt, yshift=-40pt] at (current page.north east)
        {\includegraphics[width=4cm]{./assets/logo-lid.pdf}};
    \end{tikzpicture}

    \vspace{4cm}

    \begin{flushleft}
        \begin{minipage}[t]{\textwidth}
            {\color{lid-main} \usebeamerfont{title} \bfseries \raggedright
                \inserttitle}
        \end{minipage}

        \vspace{0.25cm}

        \begin{tikzpicture}
            \draw[line width=2pt, color=lid-secondary] (0,0) -- (\textwidth,0);
        \end{tikzpicture}

        \vspace{0.25cm}

        \begin{minipage}[b]{\textwidth}
            {\color{lid-main} \usebeamerfont{author} \raggedright
                \ifx\authoronecontent\empty\else \authoronecontent\\ \fi
                \ifx\authortwocontent\empty\else \authortwocontent\\ \fi
                \ifx\authorthreecontent\empty\else \authorthreecontent\\ \fi
                \ifx\authorfourcontent\empty\else \authorfourcontent\\ \fi
                \ifx\authorfivecontent\empty\else \authorfivecontent\\ \fi}
        \end{minipage}

        {\color{lid-secondary} \small \insertdate}
        \vspace{0.5cm}
    \end{flushleft}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% FRAMETITLE — dois estilos alternáveis: dark / light
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% ---- Estilo DARK (fundo lid-main, texto branco) ----
\newcommand{\lidframetitledark}{%
    \setbeamercolor{frametitle}{bg=lid-main, fg=lid-terciary}
    \setbeamertemplate{frametitle}{
        \ifx\insertframesubtitle\empty
            \vspace{-1pt}
            \begin{beamercolorbox}[wd=\paperwidth, sep=0.5em, left]{frametitle}
                \begin{minipage}[c]{0.80\textwidth}
                    \vspace{0.5em}
                    {\color{white} \bfseries \large \insertframetitle}
                    \vspace{0.5em}
                \end{minipage}%
                \begin{minipage}[c]{0.20\textwidth}
                    \hfill\includegraphics[width=1.25cm]{./assets/logo-lid-simple.pdf}\hspace*{-0.2cm}
                \end{minipage}
            \end{beamercolorbox}
        \else
            \vspace{-1pt}
            \begin{beamercolorbox}[wd=\paperwidth, sep=0.5em, left]{frametitle}
                \raisebox{5pt}{%
                    \begin{minipage}[b]{0.80\textwidth}
                        {\color{white} \bfseries \large \insertframetitle}\\[-0.15cm]
                        {\color{white} \small \insertframesubtitle}
                    \end{minipage}}%
                \begin{minipage}[b]{0.20\textwidth}
                    \hfill\includegraphics[width=1.25cm]{./assets/logo-lid-simple.pdf}\hspace*{-0.2cm}
                \end{minipage}
            \end{beamercolorbox}
        \fi
    }
}

% ---- Estilo LIGHT (fundo branco, texto lid-main) ----
\newcommand{\lidframetitlelight}{%
    \setbeamercolor{frametitle}{bg=white, fg=lid-main}
    \setbeamertemplate{frametitle}{
        \ifx\insertframesubtitle\empty
            \vspace{-1pt}
            \begin{beamercolorbox}[wd=\paperwidth, sep=0.5em, left]{frametitle}
                \begin{minipage}[c]{0.80\textwidth}
                    \vspace{0.2em}
                    {\color{lid-main} \bfseries \large \insertframetitle}
                    \vspace{0.5em}
                \end{minipage}%
                \begin{minipage}[c]{0.20\textwidth}
                    \hfill\includegraphics[width=1.25cm]{./assets/logo-lid-simple-2.pdf}\hspace*{-0.2cm}
                \end{minipage}
            \end{beamercolorbox}
        \else
            \vspace{-1pt}
            \begin{beamercolorbox}[wd=\paperwidth, sep=0.5em, left]{frametitle}
                \raisebox{5pt}{%
                    \begin{minipage}[b]{0.80\textwidth}
                        {\color{lid-main} \bfseries \large \insertframetitle}\\[-0.15cm]
                        {\color{lid-main} \small \insertframesubtitle}
                    \end{minipage}}%
                \begin{minipage}[b]{0.20\textwidth}
                    \hfill\includegraphics[width=1.25cm]{./assets/logo-lid-simple-2.pdf}\hspace*{-0.2cm}
                \end{minipage}
            \end{beamercolorbox}
        \fi
    }
}

% ---- Seletor de estilo ----
% Uso: \lidframetitlestyle{dark}  ou  \lidframetitlestyle{light}
\newcommand{\lidframetitlestyle}[1]{%
    \ifstrequal{#1}{dark}{\lidframetitledark}{%
        \ifstrequal{#1}{light}{\lidframetitlelight}{%
            \PackageError{lid}{Estilo de frametitle desconhecido: '#1'. Use 'dark' ou 'light'}{}%
        }}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% FOOTLINE — dois estilos alternáveis: dark / light
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% ---- Estilo DARK (fundo lid-main, texto branco) ----
\newcommand{\lidfootlinedark}{%
    \setbeamercolor{footline}{bg=lid-main, fg=white}
    \setbeamertemplate{footline}{
        \ifnum\value{framenumber}>1
            \pgfmathsetmacro{\progressratio}{(\insertframenumber - 1) / (\inserttotalframenumber - 1)}
            \begin{beamercolorbox}[wd=\paperwidth, ht=3pt, dp=0pt]{footline}
                \textcolor{lid-secondary}{\rule{\progressratio\paperwidth}{3pt}}
            \end{beamercolorbox}
            \begin{beamercolorbox}[wd=\paperwidth, sep=.5em]{footline}
                \hspace{.3em}
                \color{white} \authoroneshort
                \ifx\authortwoshort\empty\else, \authortwoshort\fi
                \ifx\authorthreeshort\empty\else, \authorthreeshort\fi
                \ifx\authorfourshort\empty\else, \authorfourshort\fi
                \ifx\authorfiveshort\empty\else, \authorfiveshort\fi
                \hfill \textbf{\color{white} \insertshorttitle} \hfill \color{white} \insertdate \hfill \color{white} \insertframenumber{} / \inserttotalframenumber
                \hspace{.5em}
            \end{beamercolorbox}
        \fi
    }
}

% ---- Estilo LIGHT (fundo branco, texto lid-main) ----
\newcommand{\lidfootlinelight}{%
    \setbeamercolor{footline}{bg=white, fg=lid-main}
    \setbeamertemplate{footline}{
        \ifnum\value{framenumber}>1
            \begin{beamercolorbox}[wd=\paperwidth, sep=.5em]{footline}
                \hspace{.3em}
                \color{lid-main} \authoroneshort
                \ifx\authortwoshort\empty\else, \authortwoshort\fi
                \ifx\authorthreeshort\empty\else, \authorthreeshort\fi
                \ifx\authorfourshort\empty\else, \authorfourshort\fi
                \ifx\authorfiveshort\empty\else, \authorfiveshort\fi
                \hfill
                \textbf{\color{lid-main} \insertshorttitle}
                \hfill
                \color{lid-main} \insertdate
                \hfill
                \color{lid-main} \insertframenumber{} / \inserttotalframenumber
                \hspace{.5em}
            \end{beamercolorbox}
            \pgfmathsetmacro{\progressratio}{(\insertframenumber - 1) / (\inserttotalframenumber - 1)}
            \begin{beamercolorbox}[wd=\paperwidth, ht=3pt, dp=0pt]{footline}
                \textcolor{lid-secondary}{\rule{\progressratio\paperwidth}{3pt}}
            \end{beamercolorbox}
        \fi
    }
}

% ---- Seletor de estilo ----
% Uso: \lidfootlinestyle{dark}  ou  \lidfootlinestyle{light}
\newcommand{\lidfootlinestyle}[1]{%
    \ifstrequal{#1}{dark}{\lidfootlinedark}{%
        \ifstrequal{#1}{light}{\lidfootlinelight}{%
            \PackageError{lid}{Estilo de footline desconhecido: '#1'. Use 'dark' ou 'light'}{}%
        }}%
}

