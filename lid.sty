%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SECTION DIVIDER
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\AtBeginSection[]{
    \begin{frame}[plain]
        \begin{tikzpicture}[remember picture, overlay]
            \fill[lid-main] (current page.south west) rectangle (current page.north east);
            \node[anchor=center] at (current page.center) {
                \color{white} \usebeamerfont{title} \bfseries \insertsectionhead
            };
            \draw[line width=2pt, color=lid-secondary]
            ([xshift=2cm, yshift=-0.4cm]current page.center)
                -- ([xshift=-2cm, yshift=-0.4cm]current page.center);
        \end{tikzpicture}
    \end{frame}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% THANK YOU SLIDE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Usage: \lidthanks[Mensagem][contato/links][frase]
\newcommandx{\lidthanks}[3][1=Obrigado!, 2=, 3=]{%
    \begin{frame}[plain]
        \begin{tikzpicture}[remember picture, overlay]
            \fill[lid-main] (current page.south west) rectangle (current page.north east);
            \node[anchor=north east, xshift=-15pt, yshift=-15pt] at (current page.north east)
            {\includegraphics[width=1.5cm]{./assets/logo-lid-simple.pdf}};
            \node[anchor=center, yshift=0.8cm] at (current page.center) {
                \color{white} \usebeamerfont{title} \bfseries #1
            };
            \draw[line width=2pt, color=lid-secondary]
            ([xshift=2cm, yshift=0.3cm]current page.center)
                -- ([xshift=-2cm, yshift=0.3cm]current page.center);
            \node[anchor=north, yshift=-0.1cm] at (current page.center) {
                \begin{minipage}{0.75\paperwidth}
                    \centering
                    \ifblank{#2}{}{\textcolor{lid-secondary}{\small #2}\\[0.3cm]}%
                    \ifblank{#3}{}{\textcolor{white}{\footnotesize \textit{#3}}}%
                \end{minipage}
            };
        \end{tikzpicture}
    \end{frame}
}

