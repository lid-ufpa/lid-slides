%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% HIGHLIGHT BOX
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Usage: \lidhighlight{Texto importante}
\newcommand{\lidhighlight}[1]{%
    \begin{tikzpicture}
        \node[
            fill=lid-secondary!15,
            draw=lid-secondary,
            line width=1pt,
            rounded corners=4pt,
            inner sep=8pt,
            text width=\linewidth-20pt
        ] {\color{lid-main} #1};
    \end{tikzpicture}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% FULL-SCREEN IMAGE SLIDE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Usage: \lidfullimage[escala]{caminho/imagem.pdf}{Legenda}
\newlength{\lidcaptionheight}
\setlength{\lidcaptionheight}{1.2cm}
\newlength{\lidimgmaxh}
\newcommand{\lidfullimage}[3][1.0]{%
    \ifx&#3&\else\refstepcounter{figure}\fi%
    \begin{frame}[plain]
        \begin{tikzpicture}[remember picture, overlay]
            \ifx&#3&
                \node[anchor=center] at (current page.center)
                {\adjustbox{max width=#1\paperwidth, max height=#1\paperheight}{\includegraphics{#2}}};
            \else
                \setlength{\lidimgmaxh}{\paperheight}%
                \addtolength{\lidimgmaxh}{-\lidcaptionheight}%
                \node[anchor=south] at ([yshift=\lidcaptionheight]current page.south)
                {\adjustbox{max width=#1\paperwidth, max height=#1\lidimgmaxh}{\includegraphics{#2}}};
                \fill[lid-main]
                (current page.south west)
                rectangle ([yshift=\lidcaptionheight]current page.south west -| current page.south east);
                \node[anchor=south, yshift=0.3cm] at (current page.south) {
                    \color{white} \small \figurename~\thefigure: #3
                };
            \fi
        \end{tikzpicture}
    \end{frame}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% FULL-SCREEN TABLE SLIDE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Usage:
%   \lidfulltable[escala]{Legenda}{
%       \begin{tabular}{...} ... \end{tabular}
%   }
\newlength{\lidtablecaptionheight}
\setlength{\lidtablecaptionheight}{1.2cm}

\newcommand{\lidfulltable}[3][1.0]{%
    \refstepcounter{table}%
    \begin{frame}[plain]
        \begin{tikzpicture}[remember picture, overlay]
            \node[
                anchor=center
            ] at ([yshift=0.6cm]current page.center) {
                \adjustbox{
                    max width=#1\paperwidth,
                    max height=#1\dimexpr\paperheight-\lidtablecaptionheight\relax
                }{
                    \begin{minipage}{0.90\paperwidth}
                        \centering
                        #3
                    \end{minipage}
                }
            };
            \fill[lid-main]
            (current page.south west)
            rectangle
                ([yshift=\lidtablecaptionheight]current page.south west -| current page.south east);
            \node[
                anchor=south,
                yshift=0.3cm
            ] at (current page.south) {
                \color{white} \small \tablename~\thetable: #2
            };
        \end{tikzpicture}
    \end{frame}
}

